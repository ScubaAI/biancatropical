# ============================================================
# La Bianca — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=La Bianca

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Blink Wallet Integration
NEXT_PUBLIC_BLINK_GRAPHQL_URL=https://your-blink-wallet.com/graphql
BLINK_API_KEY=your-blink-api-key-here
BLINK_WEBHOOK_SECRET=your-webhook-secret-here

# Binance API (for MXN↔BTC conversion)
BINANCE_API_KEY=your-binance-api-key-here
BINANCE_API_SECRET=your-binance-api-secret-here

# Node Environment
NODE_ENV=development

# Feature Flags (override via env)
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_MULTI_LOCATION=true